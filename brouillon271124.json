{
	"name": "DysCoder Universal",
	"type": "dark",
	"semanticHighlighting": true,
	"tokenColors": [
		{
			"name": "Comments",
			"scope": [
				"comment",
				"comment.line",
				"comment.block",
				"comment.documentation",
				"comment.documentation.markdown",
				"punctuation.definition.comment",
				"punctuation.definition.comment.begin",
				"punctuation.definition.comment.end",
				"comment.line.double-slash",
				"comment.line.number-sign",
				"comment.line.percentage",
				"comment.line.triple-slash",
				"comment.line.shebang",
				"comment.block.documentation"
			],
			"settings": {
				"foreground": "#0384FC",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Keywords",
			"scope": [
				"keyword",
				"keyword.control",
				"keyword.operator",
				"keyword.other",
				"keyword.declaration",
				"keyword.control.flow",
				"keyword.control.conditional",
				"keyword.control.loop",
				"keyword.control.import",
				"keyword.control.export",
				"keyword.control.return",
				"keyword.control.trycatch",
				"keyword.control.switch",
				"keyword.control.default",
				"keyword.control.throw",
				"keyword.control.label",
				"keyword.operator.arithmetic",
				"keyword.operator.assignment",
				"keyword.operator.bitwise",
				"keyword.operator.increment",
				"keyword.operator.decrement",
				"keyword.operator.relational",
				"keyword.operator.logical",
				"keyword.operator.comparison",
				"keyword.operator.new",
				"keyword.operator.delete",
				"keyword.operator.typeof",
				"keyword.operator.instanceof",
				"keyword.operator.ternary",
				"keyword.operator.expression",
				"keyword.operator.optional",
				"keyword.operator.misc",
				"keyword.other.documentation"
			],
			"settings": {
				"foreground": "#FBFF00",
				"fontStyle": "bold"
			}
		},

		{
			"name": "Functions",
			"scope": [
				"entity.name.function",
				"meta.function-call",
				"meta.function-call.generic",
				"meta.function-call.static",
				"meta.function-call.object",
				"meta.function.definition",
				"meta.method-call",
				"support.function",
				"support.function.any-method",
				"support.function.builtin",
				"support.function.library",
				"entity.name.method",
				"variable.function",
				"variable.parameter.function",
				"meta.function.decorator",
				"entity.name.function.decorator",
				"support.function.magic",
				"meta.function.type"
			],
			"settings": {
				"foreground": "#FF00EA",
				"fontStyle": "bold"
			}
		},

		{
			"name": "Variables",
			"scope": [
				"variable",
				"variable.language",
				"variable.other",
				"variable.other.readwrite",
				"variable.parameter",
				"variable.parameter.function",
				"variable.other.constant",
				"support.variable",
				"support.variable.property",
				"support.variable.magic",
				"meta.definition.variable.name",
				"meta.object-literal.key",
				"entity.name.variable",
				"entity.name.variable.parameter",
				"variable.interpolation",
				"variable.other.constant.library"
			],
			"settings": {
				"foreground": "#02FFFB"
			}
		},

		{
			"name": "Strings",
			"scope": [
				"string",
				"string.quoted",
				"string.quoted.single",
				"string.quoted.double",
				"string.quoted.triple",
				"string.quoted.other",
				"string.interpolated",
				"string.template",
				"string.regexp",
				"constant.character.escape",
				"punctuation.definition.string.begin",
				"punctuation.definition.string.end",
				"punctuation.section.embedded",
				"meta.string-contents.quoted.single",
				"meta.string-contents.quoted.double",
				"meta.embedded.line"
			],
			"settings": {
				"foreground": "#FF017C"
			}
		},

		{
			"name": "Numbers",
			"scope": [
				"constant.numeric",
				"constant.numeric.integer",
				"constant.numeric.float",
				"constant.numeric.hex",
				"constant.numeric.binary",
				"constant.numeric.octal",
				"constant.numeric.complex",
				"constant.numeric.decimal",
				"constant.numeric.bigint",
				"punctuation.separator.decimal",
				"keyword.other.unit",
				"keyword.other.unit.css",
				"meta.number.integer.decimal",
				"meta.number.integer.hexadecimal",
				"meta.number.float.decimal",
				"meta.number.integer.binary",
				"meta.number.integer.octal"
			],
			"settings": {
				"foreground": "#FD7600"
			}
		},

		{
			"name": "Types",
			"scope": "entity.name.type, support.type, support.class, storage.type",
			"settings": {
				"foreground": "#4EC9B0"
			}
		},

		{
			"name": "Operators",
			"scope": "keyword.operator, punctuaction.separator",
			"settings": {
				"foreground": "#ff6a6a"
			}
		},

		{
			"name": "Markdown Headers",
			"scope": "markup.heading.markdown",
			"settings": {
				"foreground": "#FF5733",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markdown Links",
			"scope": "markup.underline.link.markdown",
			"settings": {
				"foreground": "#28B463"
			}
		},
		{
			"name": "Markdown Italics",
			"scope": "markup.italic.markdown",
			"settings": {
				"foreground": "#8E44AD",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Markdown Bold",
			"scope": "markup.bold.markdown",
			"settings": {
				"foreground": "#F4D03F",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markdown Inline Code",
			"scope": "markup.inline.raw.markdown",
			"settings": {
				"foreground": "#E67E22",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Markdown Block Code",
			"scope": "markup.fenced_code.block.markdown",
			"settings": {
				"foreground": "#1ABC9C"
			}
		},
		{
			"name": "Markdown Blockquote",
			"scope": "markup.quote.markdown",
			"settings": {
				"foreground": "#3498DB",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Markdown List Items",
			"scope": "markup.list.markdown",
			"settings": {
				"foreground": "#C0392B"
			}
		},
		{
			"name": "Markdown Horizontal Rule",
			"scope": "markup.horizontalrule.markdown",
			"settings": {
				"foreground": "#7D3C98"
			}
		},
		{
			"name": "Markdown HTML Tags",
			"scope": "text.html.markdown",
			"settings": {
				"foreground": "#2E86C1"
			}
		},
		{
			"name": "HTML Tags",
			"scope": "entity.name.tag.html",
			"settings": {
				"foreground": "#a72100"
			}
		},
		{
			"name": "HTML Attributes",
			"scope": "entity.other.attribute-name.html",
			"settings": {
				"foreground": "#00ffe6"
			}
		},
		{
			"name": "HTML Content",
			"scope": "text.html.basic",
			"settings": {
				"foreground": "#0e5b00"
			}
		}
	],
	"colors": {
		"editor.background": "#1d1d1d",
		"editor.foreground": "#ffffff",
		"editorCursor.foreground": "#FF017C",
		"editor.lineHighlightBackground": "#323232",
		"editor.selectionBackground": "#2b2d12",
		"editorWhitespace.foreground": "#2B2B2B",
		"editorLineNumber.foreground": "#636363",
		"editorLineNumber.activeForeground": "#FFFFFF",
		"editorBracketMatch.background": "#4EC9B040",
		"editorBracketMatch.border": "#FFD700",
		"editorError.foreground": "#ff0000",
		"editorWarning.foreground": "#ff8800",
		"editorInfo.foreground": "#0080ff",
		"editorGhostText.background": "#272727",
		"editorGhostText.foreground": "#c4c4c4",
		"editorGhostText.border": "#ff017c",
		"editorGroupHeader.tabsBackground": "#272727",
		"editorGroupHeader.noTabsBackground": "#272727",
		"editorGroup.border": "#272727",
		"activityBar.background": "#272727",
		"activityBar.foreground": "#ffffff",
		"activityBar.inactiveForeground": "#8d8d8d",
		"sideBar.background": "#272727",
		"sideBar.foreground": "#ffffff",
		"sideBar.border": "#ffffff",
		"titleBar.activeBackground": "#272727",
		"titleBar.activeForeground": "#ffffff",
		"titleBar.inactiveBackground": "#272727",
		"titleBar.inactiveForeground": "#6c707e",
		"tab.activeBackground": "#272727",
		"tab.inactiveBackground": "#272727",
		"tab.border": "#272727",
		"tab.activeForeground": "#48ff00",
		"tab.inactiveForeground": "#ffff",
		"tab.activeBorderTop": "#FFD700",
		"tab.unfocusedActiveBorderTop": "#ffffff",
		"list.activeSelectionBackground": "#2E2E2E",
		"list.activeSelectionForeground": "#8d8d8d",
		"list.inactiveSelectionBackground": "#664141"
	}
}