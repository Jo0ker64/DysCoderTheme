{
	"name": "DysCoder Universal",
	"type": "high-contrast",
	"semanticHighlighting": true,

	"semanticTokenColors": {
		"comment": {
			"foreground": "#0384FC",
			"fontStyle": "italic underline"
		},
		"keyword": {
			"foreground": "#FBFF00"
		},
		"function": {
			"foreground": "#FF00EA"
		},
		"variable": {
			"foreground": "#02FFFB"
		},
		"string": {
			"foreground": "#FF017C"
		},
		"number": {
			"foreground": "#FD7600"
		},
		"type": {
			"foreground": "#4EC9B0"
		},
		"operator": {
			"foreground": "#FF0000"
		},
		"namespace": {
			"foreground": "#A8A8A8"
		},
		"parameter": {
			"foreground": "#6A9955"
		},
		"constant": {
			"foreground": "#D19A66"
		},
		"property": {
			"foreground": "#4FC1FF"
		},
		"enum": {
			"foreground": "#C586C0"
		},
		"decorator": {
			"foreground": "#D7BA7D"
		}
	},

	"tokenColors": [
		{
			"name": "HTML Tags",
			"scope": "entity.name.tag.html",
			"settings": {
				"foreground": "#FF9800"
			}
		},
		{
			"name": "HTML Attributes",
			"scope": "entity.other.attribute-name.html",
			"settings": {
				"foreground": "#80CBC4"
			}
		},
		{
			"name": "HTML Embedded Text",
			"scope": "meta.embedded.block.html",
			"settings": {
				"foreground": "#FFFFFF"
			}
		},
		{
			"name": "CSS Selectors",
			"scope": "entity.other.attribute-name.class.css, entity.other.attribute-name.id.css",
			"settings": {
				"foreground": "#FFD700"
			}
		},
		{
			"name": "CSS Properties",
			"scope": "support.type.property-name.css",
			"settings": {
				"foreground": "#FF017C"
			}
		},
		{
			"name": "CSS Values",
			"scope": "support.constant.property-value.css",
			"settings": {
				"foreground": "#FFCC00"
			}
		},
		{
			"name": "JavaScript Variables",
			"scope": "variable.other.readwrite.js",
			"settings": {
				"foreground": "#02FFFB"
			}
		},
		{
			"name": "JavaScript Constants",
			"scope": "variable.other.constant.js",
			"settings": {
				"foreground": "#4EC9B0"
			}
		},
		{
			"name": "JavaScript Console",
			"scope": "support.type.object.console",
			"settings": {
				"foreground": "#FF9800"
			}
		},
		{
			"name": "Python Self",
			"scope": "variable.parameter.function.language.special.self.python",
			"settings": {
				"foreground": "#FF00EA"
			}
		},
		{
			"name": "PHP Variables",
			"scope": "variable.other.php",
			"settings": {
				"foreground": "#02FFFB"
			}
		},
		{
			"name": "PHP Keywords",
			"scope": "keyword.control.php",
			"settings": {
				"foreground": "#FBFF00"
			}
		},
		{
			"name": "PHP Functions",
			"scope": "support.function.php",
			"settings": {
				"foreground": "#FF00EA"
			}
		},
		{
			"name": "SQL Keywords",
			"scope": "keyword.other.sql",
			"settings": {
				"foreground": "#FBFF00"
			}
		},
		{
			"name": "SQL Functions",
			"scope": "support.function.sql",
			"settings": {
				"foreground": "#FF00EA"
			}
		},
		{
			"name": "SQL Values",
			"scope": "constant.numeric.sql",
			"settings": {
				"foreground": "#FFD700"
			}
		},
		{
			"name": "Markdown Headers",
			"scope": "markup.heading.markdown",
			"settings": {
				"foreground": "#FFD700",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markdown Links",
			"scope": "markup.underline.link.markdown",
			"settings": {
				"foreground": "#0384FC"
			}
		},
		{
			"name": "C++ Types",
			"scope": "entity.name.type.cpp",
			"settings": {
				"foreground": "#4EC9B0"
			}
		},
		{
			"name": "C Functions",
			"scope": "entity.name.function.c",
			"settings": {
				"foreground": "#FF00EA"
			}
		},
		{
			"name": "C Constants",
			"scope": "constant.language.c",
			"settings": {
				"foreground": "#4EC9B0"
			}
		}
	],
	
	"colors": {
	"editor.background": "#282828",
	"editor.foreground": "#FFFFFF",
	"editorCursor.foreground": "#FF017C",
	"editor.lineHighlightBackground": "#323232",
	"editor.selectionBackground": "#3A3A3A",
	"editorWhitespace.foreground": "#3A3A3A",
	"editorLineNumber.foreground": "#8D8D8D",
	"editorLineNumber.activeForeground": "#FFFFFF",
	"editorBracketMatch.background": "#4EC9B040",
	"editorBracketMatch.border": "#FFD700",
	"editorError.foreground": "#FF0000",
	"editorWarning.foreground": "#FF8800",
	"editorInfo.foreground": "#0080FF",
	"editorGhostText.background": "#282828",
	"editorGhostText.foreground": "#C4C4C4",
	"editorGhostText.border": "#FF017C",
	"editorGroupHeader.tabsBackground": "#282828",
	"editorGroupHeader.noTabsBackground": "#282828",
	"editorGroup.border": "#3A3A3A",

	"activityBar.background": "#282828",
	"activityBar.foreground": "#FFFFFF",
	"activityBar.inactiveForeground": "#8D8D8D",
	"activityBar.border": "#3A3A3A",

	"sideBar.background": "#282828",
	"sideBar.foreground": "#FFFFFF",
	"sideBar.border": "#3A3A3A",

	"titleBar.activeBackground": "#282828",
	"titleBar.activeForeground": "#FFFFFF",
	"titleBar.inactiveBackground": "#3A3A3A",
	"titleBar.inactiveForeground": "#8D8D8D",

	"tab.activeBackground": "#282828",
	"tab.inactiveBackground": "#282828",
	"tab.border": "#3A3A3A",
	"tab.activeForeground": "#48FF00",
	"tab.inactiveForeground": "#CFCFCF",
	"tab.activeBorderTop": "#FFD700",
	"tab.unfocusedActiveBorderTop": "#CFCFCF",

	"list.activeSelectionBackground": "#323232",
	"list.activeSelectionForeground": "#CFCFCF",
	"list.inactiveSelectionBackground": "#3A3A3A",
	"list.inactiveSelectionForeground": "#8D8D8D",

	"statusBar.background": "#282828",
	"statusBar.foreground": "#FFFFFF",
	"statusBar.debuggingBackground": "#FF8800",
	"statusBar.debuggingForeground": "#FFFFFF",
	"statusBar.noFolderBackground": "#3A3A3A",
	"statusBar.noFolderForeground": "#8D8D8D",
	"statusBar.border": "#3A3A3A"
}

}
