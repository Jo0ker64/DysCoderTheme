{
	"name": "DysCoder Theme",
	"type": "dark",
	"semanticHighlighting": true,
	"semanticTokenColors": {
		"variable": {
			"foreground": "#E6DB74"
		},
		"function": {
			"foreground": "#A6E22E"
		},
		"operator": {
			"foreground": "#F92672"
		},
		"type": {
			"foreground": "#66D9EF"
		},
		"string": {
			"foreground": "#E69F66"
		},
		"comment": {
			"foreground": "#75715E",
			"fontStyle": "italic"
		}
	},
	"tokenColors": [
		{
			"name": "HTML Tags",
			"scope": "entity.name.tag.html",
			"settings": {
				"foreground": "#F92672"
			}
		},
		{
			"name": "HTML Attributes",
			"scope": "entity.other.attribute-name.html",
			"settings": {
				"foreground": "#A6E22E"
			}
		},
		{
			"name": "HTML Content",
			"scope": "text.html",
			"settings": {
				"foreground": "#E6DB74"
			}
		},
		{
			"name": "CSS Selectors",
			"scope": "entity.name.tag.css",
			"settings": {
				"foreground": "#66D9EF"
			}
		},
		{
			"name": "CSS Properties",
			"scope": "support.type.property-name.css",
			"settings": {
				"foreground": "#F92672"
			}
		},
		{
			"name": "CSS Values",
			"scope": "support.constant.property-value.css",
			"settings": {
				"foreground": "#A6E22E"
			}
		},
		{
			"name": "JS Variables",
			"scope": "variable.other.readwrite.js",
			"settings": {
				"foreground": "#E6DB74"
			}
		},
		{
			"name": "JS Functions",
			"scope": "entity.name.function.js",
			"settings": {
				"foreground": "#A6E22E"
			}
		},
		{
			"name": "JS Operators",
			"scope": "keyword.operator.js",
			"settings": {
				"foreground": "#F92672"
			}
		},
		{
			"name": "Python Keywords",
			"scope": "keyword.control.python",
			"settings": {
				"foreground": "#F92672"
			}
		},
		{
			"name": "Python Functions",
			"scope": "entity.name.function.python",
			"settings": {
				"foreground": "#A6E22E"
			}
		},
		{
			"name": "Python Variables",
			"scope": "variable.parameter.python",
			"settings": {
				"foreground": "#E6DB74"
			}
		},
		{
			"name": "SQL Keywords",
			"scope": "keyword.control.sql",
			"settings": {
				"foreground": "#F92672"
			}
		},
		{
			"name": "SQL Functions",
			"scope": "support.function.sql",
			"settings": {
				"foreground": "#A6E22E"
			}
		},
		{
			"name": "SQL Constants",
			"scope": "constant.numeric.sql",
			"settings": {
				"foreground": "#66D9EF"
			}
		},
		{
			"name": "Markdown Headers",
			"scope": "markup.heading.markdown",
			"settings": {
				"foreground": "#A6E22E"
			}
		},
		{
			"name": "Markdown Links",
			"scope": "markup.underline.link.markdown",
			"settings": {
				"foreground": "#66D9EF"
			}
		},
		{
			"name": "Markdown Plain Text",
			"scope": "text.markdown",
			"settings": {
				"foreground": "#E6DB74"
			}
		}
	],
	"colors": {
		"editor.background": "#1E1E1E",
		"editor.foreground": "#D4D4D4",
		"editorCursor.foreground": "#FFFF00",
		"editor.selectionBackground": "#264F78",
		"editor.lineHighlightBackground": "#323232",
		"editorBracketMatch.border": "#A6E22E",
		"editorError.foreground": "#FF6C6B",
		"editorWarning.foreground": "#DCA561",
		"editorInfo.foreground": "#4DB5BD"
	}
}