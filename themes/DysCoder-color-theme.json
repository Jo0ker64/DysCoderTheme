	"tokenColors": [
		{
			"name": "Comments",
			"scope": "comment, punctuation.definition.comment",
			"settings": {
				"foreground": "#0384FC",
				"fontStyle": "italic underline"
			}
		},
		{
			"name": "Keywords",
			"scope": "keyword, keyword.control, keyword.operator",
			"settings": {
				"foreground": "#FBFF00"
			}
		},
		{
			"name": "Functions",
			"scope": "entity.name.function, support.function, keyword.other.special-method",
			"settings": {
				"foreground": "#FF00EA"
			}
		},
		{
			"name": "Variables",
			"scope": "variable, variable.other.readwrite",
			"settings": {
				"foreground": "#02FFFB"
			}
		},
		{
			"name": "Strings",
			"scope": "string, string.quoted",
			"settings": {
				"foreground": "#FF017C"
			}
		},
		{
			"name": "Numbers",
			"scope": "constant.numeric, constant.character.numeric",
			"settings": {
				"foreground": "#FD7600"
			}
		},
		{
			"name": "Types",
			"scope": "entity.name.type, support.type",
			"settings": {
				"foreground": "#4EC9B0"
			}
		},
		{
			"name": "Operators",
			"scope": "keyword.operator",
			"settings": {
				"foreground": "#FF0000"
			}
		},
		{
			"name": "Namespaces",
			"scope": "entity.name.namespace",
			"settings": {
				"foreground": "#A8A8A8"
			}
		},
		{
			"name": "Parameters",
			"scope": "variable.parameter",
			"settings": {
				"foreground": "#6A9955"
			}
		},
		{
			"name": "Constants",
			"scope": "constant.language, constant.character.escape",
			"settings": {
				"foreground": "#D19A66"
			}
		},
		{
			"name": "Properties",
			"scope": "variable.other.property",
			"settings": {
				"foreground": "#4FC1FF"
			}
		},
		{
			"name": "Enums",
			"scope": "variable.other.enummember",
			"settings": {
				"foreground": "#C586C0"
			}
		},
		{
			"name": "Decorators",
			"scope": "entity.name.decorator",
			"settings": {
				"foreground": "#D7BA7D"
			}
		},


		{
			"name": "HTML Tags",
			"scope": "entity.name.tag.html",
			"settings": {
				"foreground": "#FF9800"
			}
		},
		{
			"name": "HTML Attributes",
			"scope": "entity.other.attribute-name.html",
			"settings": {
				"foreground": "#80CBC4"
			}
		},
		{
			"name": "HTML Embedded Text",
			"scope": "meta.embedded.block.html",
			"settings": {
				"foreground": "#FFFFFF"
			}
		},
		{
			"name": "CSS Selectors",
			"scope": "entity.other.attribute-name.class.css, entity.other.attribute-name.id.css",
			"settings": {
				"foreground": "#FFD700"
			}
		},
		{
			"name": "CSS Properties",
			"scope": "support.type.property-name.css",
			"settings": {
				"foreground": "#FF017C"
			}
		},
		{
			"name": "CSS Values",
			"scope": "support.constant.property-value.css",
			"settings": {
				"foreground": "#FFCC00"
			}
		},
		{
			"name": "JavaScript Variables",
			"scope": "variable.other.readwrite.js",
			"settings": {
				"foreground": "#02FFFB"
			}
		},
		{
			"name": "JavaScript Constants",
			"scope": "variable.other.constant.js",
			"settings": {
				"foreground": "#4EC9B0"
			}
		},
		{
			"name": "JavaScript Console",
			"scope": "support.type.object.console",
			"settings": {
				"foreground": "#FF9800"
			}
		},
		{
			"name": "Python Self",
			"scope": "variable.parameter.function.language.special.self.python",
			"settings": {
				"foreground": "#FF00EA"
			}
		},
		{
			"name": "PHP Variables",
			"scope": "variable.other.php",
			"settings": {
				"foreground": "#02FFFB"
			}
		},
		{
			"name": "PHP Keywords",
			"scope": "keyword.control.php",
			"settings": {
				"foreground": "#FBFF00"
			}
		},
		{
			"name": "PHP Functions",
			"scope": "support.function.php",
			"settings": {
				"foreground": "#FF00EA"
			}
		},
		{
			"name": "SQL Keywords",
			"scope": "keyword.other.sql",
			"settings": {
				"foreground": "#FBFF00"
			}
		},
		{
			"name": "SQL Functions",
			"scope": "support.function.sql",
			"settings": {
				"foreground": "#FF00EA"
			}
		},
		{
			"name": "SQL Values",
			"scope": "constant.numeric.sql",
			"settings": {
				"foreground": "#FFD700"
			}
		},
		{
			"name": "Markdown Headers",
			"scope": "markup.heading.markdown",
			"settings": {
				"foreground": "#FFD700",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markdown Links",
			"scope": "markup.underline.link.markdown",
			"settings": {
				"foreground": "#0384FC"
			}
		},
		{
			"name": "C++ Types",
			"scope": "entity.name.type.cpp",
			"settings": {
				"foreground": "#4EC9B0"
			}
		},
		{
			"name": "C Functions",
			"scope": "entity.name.function.c",
			"settings": {
				"foreground": "#FF00EA"
			}
		},
		{
			"name": "C Constants",
			"scope": "constant.language.c",
			"settings": {
				"foreground": "#4EC9B0"
			}
		}
	],

	
}