{
	"name": "DysCoder Universal",
	"type": "dark",
	"semanticHighlighting": true,

	"tokenColors": [
		{
			"name": "Variables",
			"scope": "variable",
			"settings": {
				"foreground": "#02FFFB"
			}
		},
		{
			"name": "Keywords",
			"scope": "keyword",
			"settings": {
				"foreground": "#FBFF00"
			}
		},
		{
			"name": "Functions",
			"scope": "entity.name.function",
			"settings": {
				"foreground": "#FF00EA"
			}
		},
		{
			"name": "Types",
			"scope": "entity.name.type, support.type",
			"settings": {
				"foreground": "#06f6c6"
			}
		},
		{
			"name": "Numbers",
			"scope": "constant.numeric",
			"settings": {
				"foreground": "#FD7600"
			}
		},
		{
			"name": "Strings",
			"scope": "string",
			"settings": {
				"foreground": "#FF017C"
			}
		},
		{
			"name": "Comments",
			"scope": "comment, punctuation.definition.comment",
			"settings": {
				"foreground": "#0384FC",
				"fontStyle": "italic underline"
			}
		},
		{
			"name": "Operators",
			"scope": "keyword.operator",
			"settings": {
				"foreground": "#ff0000"
			}
		},


		{
			"name": "Markdown Headers",
			"scope": "markup.heading.markdown",
			"settings": {
				"foreground": "#FF5733",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markdown Links",
			"scope": "markup.underline.link.markdown",
			"settings": {
				"foreground": "#28B463"
			}
		},
		{
			"name": "Markdown Italics",
			"scope": "markup.italic.markdown",
			"settings": {
				"foreground": "#8E44AD",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Markdown Bold",
			"scope": "markup.bold.markdown",
			"settings": {
				"foreground": "#F4D03F",
				"fontStyle": "bold"
			}
		},
		{
			"name": "Markdown Inline Code",
			"scope": "markup.inline.raw.markdown",
			"settings": {
				"foreground": "#E67E22",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Markdown Block Code",
			"scope": "markup.fenced_code.block.markdown",
			"settings": {
				"foreground": "#1ABC9C"
			}
		},
		{
			"name": "Markdown Blockquote",
			"scope": "markup.quote.markdown",
			"settings": {
				"foreground": "#3498DB",
				"fontStyle": "italic"
			}
		},
		{
			"name": "Markdown List Items",
			"scope": "markup.list.markdown",
			"settings": {
				"foreground": "#C0392B"
			}
		},
		{
			"name": "Markdown Horizontal Rule",
			"scope": "markup.horizontalrule.markdown",
			"settings": {
				"foreground": "#7D3C98"
			}
		},
		{
			"name": "Markdown HTML Tags",
			"scope": "text.html.markdown",
			"settings": {
				"foreground": "#2E86C1"
			}
		},


		{
			"name": "HTML Tags",
			"scope": "entity.name.tag.html",
			"settings": { "foreground": "#a72100" }
		},
		{
			"name": "HTML Attributes",
			"scope": "entity.other.attribute-name.html",
			"settings": { "foreground": "#00ffe6" }
		},
		{
			"name": "HTML Content",
			"scope": "text.html.basic",
			"settings": { "foreground": "#0e5b00" }
		},

		


		
		
	],
	"colors": {
		"editor.background": "#1d1d1d",
		"editor.foreground": "#ffffff",
		"editorCursor.foreground": "#FF017C",
		"editor.lineHighlightBackground": "#323232",
		"editor.selectionBackground": "#2b2d12",
		"editorError.foreground": "#FF0000",
		"editorWarning.foreground": "#DDFF00",
		"editorInfo.foreground": "#003D79",
		"editorWhitespace.foreground": "#2B2B2B",
		"editorLineNumber.foreground": "#636363",
		"editorLineNumber.activeForeground": "#FFFFFF",
		"editorBracketMatch.background": "#4EC9B040",
		"editorBracketMatch.border": "#FFD700",
		"activityBar.background": "#1d1d1d",
		"sideBar.background": "#1d1d1d",
		"titleBar.activeBackground": "#1d1d1d",
		"titleBar.activeForeground": "#1d1d1d"
	}
}